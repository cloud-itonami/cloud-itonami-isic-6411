{:paths ["src"]
 ;; langgraph brings langchain transitively (both zero-/single-dep,
 ;; all .cljc -> portable to JVM / SCI / ClojureScript / GraalVM). It lives
 ;; in the kotoba-lang org of this workspace (transferred + renamed from
 ;; com-junkawasaki/langgraph-clj / com-junkawasaki/langchain-clj). This
 ;; repo is standalone (forkable outside the workspace); the :local/root
 ;; paths only resolve inside the monorepo checkout — a standalone fork
 ;; should override them with git coordinates.
 :deps {
        ;; kotoba.robotics.process: the process-physics solvers and probe this
        ;; repo's physics.edn runs on (physical-AI bot, scripts/physical-ai-bots).
        io.github.kotoba-lang/robotics {:local/root "../../kotoba-lang/robotics"}

        ;; kotoba.lang.text, not clojure.string. Pinned as an explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, so without a floor here
        ;; this repo silently rides whatever a sibling happens to name.
        io.github.kotoba-lang/text {:git/sha "73bdb13ae7a3d004b44bca08be03a3191157a38f"}
       io.github.kotoba-lang/langgraph
        {:local/root "../../kotoba-lang/langgraph"}
        ;; jp-go-dds (デジタル庁デザインシステム) -- the workspace's BASE
        ;; design system (root CLAUDE.md, 2026-08-05). `reserve.render-html`
        ;; inlines `jp-go-dds.skin/dds+skin` into the generated operator
        ;; console so the page has no external stylesheet fetch. Git
        ;; coordinate (not :local/root) so the render-html build also works
        ;; in a standalone fork outside the monorepo checkout.
        io.github.kotoba-lang/jp-go-digital-design-system
        {:git/url "https://github.com/kotoba-lang/jp-go-digital-design-system"
         :git/sha "83db99546eabc53613ae826ea41d1533a3c574af"}
        ;; optional: reserve.corporate-intel's cross-reference into
        ;; cloud-itonami-isic-8291. Only reserve.corporate-intel itself
        ;; requires `dossier.*` -- reserveadvisor/operation/governor
        ;; have zero compile-time dependency on it (the screen fn is
        ;; plain-injected).
        io.github.cloud-itonami/cloud-itonami-isic-8291
        {:local/root "../cloud-itonami-isic-8291"}
        ;; langchain-store: the shared langchain.db store seam (EDN-blob
        ;; codec + identity schema + event-log helpers) that ~190 actors
        ;; hand-roll; reserve.store is an adopter (ADR-2607141600).
        io.github.kotoba-lang/langchain-store
        {:local/root "../../kotoba-lang/langchain-store"}}
 :aliases
 {
  ;; kbb -M:physics -> the physical-AI bot's measurement: runs physics.edn on
  ;; kotoba.robotics.process and prints one probe map. Exit 2 = could not measure.
  :physics {:main-opts ["-m" "kotoba.robotics.process.probe"]}
  ;; kbb -M:physai-test -> test/'s .cljk on kbb's runner (the bot's test count;
  ;; a .kotoba vertical's own :test may refuse kbb on purpose).
  ;; -n: the portable namespaces of reserve.portable-cljs-test-runner except
  ;; reserve.corporate-intel-test, which needs dossier.store from cloud-itonami-isic-8291 -- a
  ;; .kotoba namespace kbb cannot load (the JVM :test alias still runs all of test/).
  :physai-test {:extra-paths ["test" "test-physai"]
                :main-opts ["-m" "cognitect.test-runner" "-d" "test/reserve" "-d" "test-physai"
                            "-n" "reserve.facts-test" "-n" "reserve.governor-contract-test" "-n" "reserve.kernels.gate-test" "-n" "reserve.phase-test" "-n" "reserve.registry-test" "-n" "reserve.store-contract-test" "-n" "reserve.physics-spec-test"]}
;; offline workspace dev -- pin transitive langchain to local checkout
  :dev {:override-deps
        {io.github.kotoba-lang/langchain
         {:local/root "../../kotoba-lang/langchain"}}}
  ;; kbb -M:dev:run  -> drive the demo through one OperationActor
  :run {:main-opts ["-m" "reserve.sim"]}
  ;; kbb -M:dev:render-html [out-file] -> regenerate
  ;; docs/samples/operator-console.html through the REAL actor stack
  ;; (flagship checklist item 2, ADR-2607189300). Throws if the run
  ;; produces no HARD governor hold -- see reserve.render-html.
  :render-html {:main-opts ["-m" "reserve.render-html"]}
  :test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}
                      ;; kototama.tender hosts the wasm/reserve_ratio.kotoba
                      ;; build (see wasm/README.md) -- test-only, the actor's
                      ;; own runtime code has no wasm/host dependency.
                      io.github.kotoba-lang/kototama
                      {:local/root "../../kotoba-lang/kototama"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  ;; PRIMARY gate: the same portable .cljc suite under a real
  ;; ClojureScript host (runtime priority: cljs first, JVM compat).
  ;;   kbb -Sdeps '{:paths ["src" "test"]}' -M:dev:cljs \
  ;;     -m cljs.main --target node -m reserve.portable-cljs-test-runner
  :cljs {:extra-deps {org.clojure/clojurescript {:mvn/version "1.11.132"}}}
  ;; static analysis -- clj-kondo from deps (no binary), errors fail CI.
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts    ["-m" "clj-kondo.main"
                        "--lint" "src" "test"
                        "--fail-level" "error"]}}}
